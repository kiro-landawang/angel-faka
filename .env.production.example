# Production security baseline
# Copy this file to .env.production on the server and replace every placeholder.
NODE_ENV=production
# Neon PostgreSQL pooled connection string, including sslmode=require
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/angel_faka?sslmode=require
NEXT_PUBLIC_URL=https://REPLACE_DOMAIN
ADMIN_USERNAME=ANGEL旗舰
ADMIN_PASSWORD=REPLACE_LONG_RANDOM_INITIAL_PASSWORD
# Required for administrator login; never reuse the admin password.
ADMIN_ACCESS_TOKEN=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_TOKEN
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
RETENTION_PURGE_TOKEN=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_TOKEN
COOKIE_NAME=angel_faka_admin_session
ENABLE_SECURE_COOKIE=true
LOG_LEVEL=warn
# Keep payment/email disabled until credentials are intentionally configured.
