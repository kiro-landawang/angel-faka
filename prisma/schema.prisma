// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Merchant {
  id         String     @id @default(cuid())
  username   String     @unique
  password   String
  name       String
  slug       String     @unique
  status     String     @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  categories Category[]
  products           Product[]
  licenses           License[]
  orders             Order[]
  sourceOrders       Order[]    @relation("OrderSourceMerchant")
  resellerOrders     Order[]    @relation("OrderResellerMerchant")
  coupons            Coupon[]
  createdAt          DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  priority   Int       @default(0)
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  products   Product[]
  coupons   Coupon[]
  createdAt DateTime  @default(now())
}

model Product {
  id             String    @id @default(cuid())
  name           String
  description    String?
  price          Decimal
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  merchantId     String?
  merchant       Merchant? @relation(fields: [merchantId], references: [id])
  licenses       License[]
  orders         Order[]
  sourceOrders   Order[] @relation("OrderSourceProduct")
  coupons        Coupon[]
  deliveryFormat String    @default("SINGLE") // SINGLE, ACCOUNT_PASS, ACCOUNT_FULL, PROXY_IP, VIRTUAL_CARD
  allowResale    Boolean   @default(false)
  resalePrice    Decimal?
  resaleMinPrice Decimal?
  sourceProductId String?
  sourcePrice     Decimal?
  sourceProduct   Product?  @relation("ProductResaleSource", fields: [sourceProductId], references: [id])
  resellerProducts Product[] @relation("ProductResaleSource")

  isActive  Boolean  @default(true)

  // ---- 抽奖 / 积分体系 ----
  lotteryDraws  Int     @default(0)     // 每购买 1 件赠送给用户的抽奖次数
  isRedeemable Boolean @default(false)  // 是否允许用积分兑换此商品
  redeemCost   Int?                    // 兑换所需积分（isRedeemable=true 时生效）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model License {
  id        String   @id @default(cuid())
  code      String // The actual card content/key
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  status     String   @default("AVAILABLE") // AVAILABLE, SOLD, LOCKED
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String    @id @default(cuid())
  orderNo       String    @unique // Readable order number
  email         String? // Contact info
  totalAmount   Decimal
  status        String    @default("PENDING") // PENDING, PAID, FAILED, EXPIRED
  productId          String
  product            Product   @relation(fields: [productId], references: [id])
  merchantId         String?
  merchant           Merchant? @relation(fields: [merchantId], references: [id])
  sourceMerchantId   String?
  sourceMerchant     Merchant? @relation("OrderSourceMerchant", fields: [sourceMerchantId], references: [id])
  resellerMerchantId String?
  resellerMerchant   Merchant? @relation("OrderResellerMerchant", fields: [resellerMerchantId], references: [id])
  sourceProductId    String?
  sourceProduct      Product?  @relation("OrderSourceProduct", fields: [sourceProductId], references: [id])
  resellerProfit     Decimal?  @default(0)
  quantity           Int       @default(1)
  licenses      License[]
  paymentMethod String?
  paidAt        DateTime?
  emailSent     Boolean   @default(false)
  couponId      String?   @unique
  coupon        Coupon?   @relation(fields: [couponId], references: [id])

  // 抽奖 / 积分体系：下单用户（登录后必填）
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  drawsGranted  Boolean  @default(false) // 支付成功后是否已发放抽奖次数（按订单幂等）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    @default("FIXED") // FIXED, PERCENTAGE
  discountValue Decimal?  @default(0)
  productId     String? // Optional: only valid for this product
  product       Product?  @relation(fields: [productId], references: [id])
  merchantId    String?
  merchant      Merchant? @relation(fields: [merchantId], references: [id])
  categoryId    String? // Optional: only valid for this category
  category      Category? @relation(fields: [categoryId], references: [id])
  isUsed        Boolean   @default(false)
  order         Order?
  usageLimit    Int       @default(1)  // 使用次数上限，0 = 无限使用
  usedCount     Int       @default(0)  // 已使用次数
  createdAt     DateTime  @default(now())
  usedAt        DateTime?
}

model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 全局速率限制桶（跨 Serverless 实例共享，避免内存 Map 在 Vercel 多实例下失效）
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
}

// 前台账户（抽奖 / 积分体系）：用户注册登录后用于累计积分与抽奖次数
model Customer {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  points        Int      @default(0)      // 当前可用积分
  drawsAvailable Int     @default(0)      // 当前可用抽奖次数
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]
  lotteryDraws  LotteryDraw[]
  pointLedger   PointLedger[]
}

// 抽奖记录（每次抽奖一条）
model LotteryDraw {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  resultType    String                      // points_1 | points_2 | points_3 | egg
  pointsAwarded Int      @default(0)        // 本次获得积分（彩蛋为随机值）
  createdAt     DateTime @default(now())

  @@index([customerId])
}

// 积分流水（每笔积分变动一条，便于后台审计与对账）
model PointLedger {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type          String                      // earn_draw | earn_egg | redeem | adjust
  amount        Int                         // 正=收入，负=支出
  balanceAfter  Int                         // 变动后余额
  ref           String?                     // 关联单号 / 订单号 / 备注
  createdAt     DateTime @default(now())

  @@index([customerId])
}
